#!/bin/bash
#PBS -A AC2
#PBS -q gpu
#PBS -b 1
#PBS -l elapstim_req=24:00:00

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit with submit_gpu_input_sweep_nqsv.sh}"
workers="${GPU_SWEEP_WORKERS:-2:4:8:12:16:24:32:40:48:64}"
[[ "$workers" =~ ^[0-9]+(:[0-9]+)*$ ]] || {
    echo 'GPU_SWEEP_WORKERS must be a colon-separated integer list' >&2; exit 2;
}
workers="${workers//:/ }"
args=(--dataset "${GPU_SWEEP_DATASET:-arxiv}"
    --output "${GPU_SWEEP_OUTPUT:?Missing GPU_SWEEP_OUTPUT}"
    --workers "$workers"
    --phase "${GPU_SWEEP_PHASE:-all}"
    --backend "${GPU_SWEEP_BACKEND:-both}"
    --pyg-base-config "${GPU_SWEEP_PYG_CONFIG:?Missing GPU_SWEEP_PYG_CONFIG}")
case "${GPU_SWEEP_COMPILE:-0}" in
    0) ;;
    1) args+=(--compile) ;;
    *) echo 'GPU_SWEEP_COMPILE must be 0 or 1' >&2; exit 2 ;;
esac
exec ./benchmark_scripts/pegasus/run_gpu_input_sweep.sh "${args[@]}"
