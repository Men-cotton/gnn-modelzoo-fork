#!/bin/bash
#PBS -A AC2
#PBS -q gpu
#PBS -b 1
#PBS -l elapstim_req=24:00:00

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit with submit_gpu_input_sweep_nqsv.sh}"
dataset="${GPU_SWEEP_DATASET:-arxiv}"
phase="${GPU_SWEEP_PHASE:-workers}"
backend="${GPU_SWEEP_BACKEND:-both}"
worker="${GPU_SWEEP_WORKER:-}"
case "$phase" in
    prefetch1|persistent-off|feature-cache) worker=4 ;;
    tune|workers)
        [[ "$worker" =~ ^[0-9]+$ ]] || {
            echo 'GPU_SWEEP_WORKER must be one non-negative integer for tune/workers.' >&2; exit 2;
        }
        ;;
    *) echo "Unsupported split phase: $phase" >&2; exit 2 ;;
esac
args=(--dataset "$dataset"
    --output "${GPU_SWEEP_OUTPUT:?Missing GPU_SWEEP_OUTPUT}/${dataset}"
    --workers "$worker"
    --phase "$phase"
    --backend "$backend"
    --worker-suffix "w${worker}")
if [[ -n "${GPU_SWEEP_PYG_CONFIG:-}" ]]; then
    args+=(--pyg-base-config "$GPU_SWEEP_PYG_CONFIG")
fi
case "${GPU_SWEEP_COMPILE:-0}" in
    0) ;;
    1) args+=(--compile) ;;
    *) echo 'GPU_SWEEP_COMPILE must be 0 or 1' >&2; exit 2 ;;
esac
exec ./benchmark_scripts/pegasus/run_gpu_input_sweep.sh "${args[@]}"
