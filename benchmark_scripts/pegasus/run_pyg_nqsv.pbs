#!/bin/bash
#PBS -A AC2
#PBS -q gpu
#PBS -b 1
#PBS -l elapstim_req=02:00:00
#PBS -M mencotton0410@gmail.com
#PBS -m e

set -euo pipefail

cd "$PBS_O_WORKDIR" || exit 1

find_project_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/common.sh" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

PROJECT_ROOT="$(find_project_root)" || {
    echo "[ERROR] project root not found from PBS_O_WORKDIR=${PBS_O_WORKDIR:-}" >&2
    exit 2
}
cd "$PROJECT_ROOT"

source "${PROJECT_ROOT}/common.sh"
source "${PROJECT_ROOT}/benchmark_scripts/pegasus/gpu_env.sh"

PYG_BENCHMARK="${PYG_BENCHMARK:-graphsage_ogbn_arxiv}"
PYG_RUN_PROFILE="${PYG_RUN_PROFILE:-throughput_nocache}"
PYG_NO_COMPILE="${PYG_NO_COMPILE:-0}"
NO_COMPILE_ARG=()

case "$PYG_BENCHMARK" in
    graphsage_ogbn_arxiv|graphsage_arxiv|arxiv)
        CONFIG_PREFIX="params_graphsage_ogbn_arxiv"
        ;;
    graphsage_ogbn_products|graphsage_ogbn_product|products|product)
        CONFIG_PREFIX="params_graphsage_ogbn_products"
        ;;
    graphsage_ogbn_papers100m|graphsage_ogbn_papers100M|papers100m|papers100M)
        CONFIG_PREFIX="params_graphsage_ogbn_papers100m"
        ;;
    gcn_ogbn_arxiv|gcn_arxiv)
        CONFIG_PREFIX="params_gcn_ogbn_arxiv"
        ;;
    *)
        echo "[ERROR] unknown PYG_BENCHMARK: $PYG_BENCHMARK" >&2
        echo "[ERROR] expected one of: graphsage_ogbn_arxiv graphsage_ogbn_products graphsage_ogbn_papers100m gcn_ogbn_arxiv" >&2
        exit 2
        ;;
esac

case "$PYG_RUN_PROFILE" in
    throughput_nocache)
        ;;
    throughput_cache)
        if [ "$CONFIG_PREFIX" = "params_gcn_ogbn_arxiv" ]; then
            echo "[ERROR] PYG_RUN_PROFILE=throughput_cache is not defined for full-batch GCN." >&2
            echo "[ERROR] expected one of for GCN: throughput_nocache accuracy_nocache" >&2
            exit 2
        fi
        ;;
    accuracy_nocache)
        ;;
    *)
        echo "[ERROR] unknown PYG_RUN_PROFILE: $PYG_RUN_PROFILE" >&2
        echo "[ERROR] expected one of: throughput_nocache throughput_cache accuracy_nocache" >&2
        exit 2
        ;;
esac

CONFIG_PATH="src/cerebras/modelzoo/models/gnn/configs/${CONFIG_PREFIX}_${PYG_RUN_PROFILE}.yaml"

case "$PYG_NO_COMPILE" in
    1|true|TRUE|yes|YES)
        NO_COMPILE_ARG=(--no-compile)
        ;;
    0|false|FALSE|no|NO)
        ;;
    *)
        echo "[ERROR] unknown PYG_NO_COMPILE value: $PYG_NO_COMPILE" >&2
        echo "[ERROR] expected boolean value: 0/1, false/true, no/yes" >&2
        exit 2
        ;;
esac

echo "[pbs] PYG_BENCHMARK=$PYG_BENCHMARK"
echo "[pbs] PYG_RUN_PROFILE=$PYG_RUN_PROFILE"
echo "[pbs] PYG_NO_COMPILE=$PYG_NO_COMPILE"
echo "[pbs] CONFIG_PATH=$CONFIG_PATH"
echo "[pbs] PBS_JOBID=${PBS_JOBID:-}"
echo "[pbs] PBS_O_WORKDIR=${PBS_O_WORKDIR:-}"
echo "[pbs] hostname=$(hostname 2>/dev/null || echo unknown)"

if ! load_cuda_module; then
    echo "[WARN] CUDA module load failed. Stopping before production run." >&2
    exit 3
fi
if ! require_cuda_toolkit; then
    echo "[WARN] CUDA toolkit is not visible. Stopping before production run." >&2
    exit 3
fi

if [ ! -f "$CONFIG_PATH" ]; then
    echo "[ERROR] config not found: $CONFIG_PATH" >&2
    exit 2
fi

"${PROJECT_ROOT}/benchmark_scripts/pegasus/run_pyg.sh" --config "$CONFIG_PATH" "${NO_COMPILE_ARG[@]}"
